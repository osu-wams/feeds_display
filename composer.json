{
    "name": "osu-wams/live_feeds",
    "type": "drupal-custom-module",
    "description": "Allows showing RSS feeds from OSU sources in a site.",
    "license": "GPL-2.0-or-later",
    "minimum-stability": "stable",
    "authors": [
        {
            "name": "Matthew Brabham",
            "email": "matthew.brabham@oregonstate.edu"
        }
    ],
    "repositories": [
        {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        }
    ],
    "scripts": {
        "cs-checkstyle": "phpcs -q --report=checkstyle",
        "phpcs": "phpcs",
        "phpcbf": "phpcbf",
        "twigcs": "twigcs"
    },
    "require": {
        "ext-dom": "*",
        "ext-simplexml": "*",
        "ext-tidy": "*",
        "ext-libxml": "*",
        "drupal/date_ap_style": "^1.0 | ^2.1.2"
    },
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^1.2",
        "squizlabs/php_codesniffer": "^3.13",
        "drupal/coder": "^8.3",
        "friendsoftwig/twigcs": "^6.6",
        "friendsofphp/php-cs-fixer": "^3.95",
        "drupol/phpcsfixer-configs-drupal": "^2.2"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "drupal/core-composer-scaffold": false
        }
    }
}
