{# card-item.twig #}
<div class="live-feeds-card-item" style="--card-bg-image: url({{ thumbnail }});">
  <div class="live-feeds-card-item__wrapper">
    <h3 class="live-feeds-card-item__title">{{ title_link }}</h3>
    <span class="live-feeds-card-item__category">{{ category }}</span>
    <time class="live-feeds-card-item__date" datetime="{{ timestamp }}">{{ date }}</time>
    <span class="live-feeds-card-item__arrow bg-osuorange fa-solid fa-arrow-right osu-icons p-2 rounded-circle"></span>
  </div>
</div>
