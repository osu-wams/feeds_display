{# cards.twig #}
<div class="{{ wrapper_class }} d-flex flex-column d-md-grid gap-3 text-secondary" data-items="{{ max_items }}">
  {% for item in items %}
    {{ include('live_feeds:card-item', {
      date: item.date,
      timestamp: item.timestamp,
      title_link: item.title_link,
      title: item.title,
      link: item.link,
      thumbnail: item.thumbnail,
      teaser: item.teaser,
      category: item.category,
    }, with_context: false) }}
  {% endfor %}
</div>
